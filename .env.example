# SMTP Configuration for sending confirmation and admin emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="বিমূর্ত রাত্রি" <noreply@bimurtoratri.com>

# Admin email to receive new registration notifications
